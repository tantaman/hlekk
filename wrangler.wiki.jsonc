{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hlekk-wiki",
  // The Wikimedia demo, deployed. Unlike wrangler.jsonc and wrangler.app.jsonc, which are local
  // harnesses the suite drives on workerd, this one is meant to be `wrangler deploy`-ed: it is how
  // the import is proven against real Durable Objects, real KV and a real network before anything
  // the size of enwiki is committed to it.
  "main": "src/worker/wiki-app.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "HLEKK_HOSTS", "class_name": "HlekkHostDO" },
      { "name": "HLEKK_DIRECTORY", "class_name": "HlekkDirectoryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HlekkHostDO", "HlekkDirectoryDO"] }],
  // Real, created with `wrangler kv namespace create hlekk-map-wiki`. The id in wrangler.app.jsonc
  // is a placeholder that only local workerd accepts.
  "kv_namespaces": [{ "binding": "HLEKK_MAP", "id": "af144fc56d0541699307352f0a63ab76" }],
  "vars": {
    // A database of its own, so the pilot shares no host DO with the issue-tracker demo. Changing
    // this name is how a clean slate is had: host DOs are named `${HLEKK_DATABASE}/h-${n}`, so a new
    // name is a new set of empty objects, and an empty baseline is what the storage multiplier has
    // to be read against. There is still no import, export or truncate for a deployed Durable
    // Object's SQLite -- so a new name *abandons* the old database rather than removing it. What
    // reclaims it is `POST /admin/wipe`, which asks each of that database's objects to erase itself;
    // it is armed by HLEKK_WIPE below and refuses anything that var does not name.
    "HLEKK_DATABASE": "wiki-simple-cat",
    // 128 vshards over ~50 hosts: 2-3 per host, ~2 GB apiece at the demo's target size, and the
    // shape src/client/fanout.test.ts measured at 61-81 host requests for a ~500-object read. The
    // count is read once, when the directory first opens, so it is chosen before the load and
    // cannot be changed by editing this afterwards.
    "HLEKK_VSHARDS": "128"
  },
  // The other two deployments, holding the same wiki under a title-hash placement and under one
  // derived from the link graph. `?placement=b` and `?placement=c` are forwarded to them, so the
  // comparison is same-origin for the browser and never leaves Cloudflare. Both have to be deployed
  // first: a service binding names a Worker that must already exist.
  "services": [
    { "binding": "HLEKK_ALT", "service": "hlekk-wiki-hash" },
    { "binding": "HLEKK_ALT2", "service": "hlekk-wiki-graph" }
  ],
  // HLEKK_WIPE is deliberately absent too, and for a sharper reason: it arms POST /admin/wipe, which
  // tells every object of the database it names to erase itself. Without the var the route refuses
  // everything, so this public demo carries no working way to destroy data. Arming it is a
  // deliberate deploy -- set it to the comma-separated names of the abandoned databases being
  // reclaimed, run the wipes, then deploy again without it.
  //
  // HLEKK_ADMIN_TOKEN is absent from every one of these configs, and has to stay absent: it is a
  // secret, and `vars` is committed. It is the bearer token that opens /admin/* and /ingest/*, which
  // refuse everything without it -- so what this file deploys can be read and cannot be changed.
  // To operate a deployment, set one on that Worker and hand the same value to the driver:
  //
  //   openssl rand -hex 32 | npx wrangler secret put HLEKK_ADMIN_TOKEN --config wrangler.wiki.jsonc
  //   HLEKK_ADMIN_TOKEN=... node scripts/load-wiki.ts --base https://...
  //
  // and `wrangler secret delete` it afterwards to close the deployment again. The same Worker runs
  // from wrangler.wiki-hash.jsonc, wrangler.wiki-graph.jsonc and wrangler.enwiki.jsonc; each holds
  // its own token, and a driver's `--placement` forward needs the two ends to share one. Locally,
  // put it in `.dev.vars`, which is ignored. See `src/worker/guard.ts`.
  //
  // HLEKK_SHED_BYTES is deliberately absent. It lowers the placement controller's threshold so a
  // demo can be watched rebalancing, and this database must not rebalance: wikimedia-demo.md puts
  // moves and epoch transitions out of scope and keeps every vshard at epoch 0, which is what keeps
  // the subtlest machinery in the system off the demo path. Without it the controller keeps its
  // real threshold and nothing sheds at pilot size.
  "observability": { "enabled": true }
}
