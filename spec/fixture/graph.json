  "foreignEdges": [
    {
      "edge": "conf.page_elsewhere",
      "from": "elsewhere-owner",
      "to": "https://nobody.invalid/db#1",
      "time": 1,
      "why": "A reference into a database nobody runs. A URI is mintable before the database behind it exists, which is the point of the design \u2014 so a read of this has to list the reference and have no object for it."
    }
  ],
  "policy": {
    "comment": "What the implementation under test must enforce. Each rule is the smallest that makes one protocol property observable from outside.",
    "hidden": {
      "objects": [
        "hidden"
      ],
      "why": "Never visible to anyone. Forbidden has to be indistinguishable from absent, and TRANSITIVELY so: `behind-hidden` is reachable only through `hidden`, and had `hidden` genuinely not existed it would never have been gathered either."
    },
    "countless": {
      "edges": [
        "conf.page_tags"
      ],
      "why": "Objects yes, counts no. A count is one maintained row and therefore free, so it rides along on a read authorized for something else unless it is asked about separately."
    },
    "signedOnly": {
      "objects": [
        "visible-b"
      ],
      "why": "Visible to a verified caller and not to the anonymous one, so a suite that can sign has something to show for it."
    },
    "backlinks": {
      "edge": "conf.page_cited_by",
      "why": "Only for an implementation that takes hints (section 11). A hint from ANY caller whose target is a conf.page that caller could itself read is checked by a read made as the anonymous caller, recorded under this edge when that read lists the reference, and removed when a later read does not. A hint whose target is `hidden`, or no object at all, causes no read. The suite is the caller: it serves a descriptor and a read route of its own on a loopback port, signs its hints, and then reads this database to see what was recorded."
    },
    "cache": {
      "reuse": "public",
      "seconds": 60
    }
  }
}
