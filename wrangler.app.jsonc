{
  "name": "hlekk-app",
  // A database over several host Durable Objects, a directory Durable Object, and a KV namespace for
  // the published shard map. `npm run app` runs it on local workerd and asserts what it did; nothing
  // here is deployed by the suite.
  "main": "src/worker/app.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "HLEKK_HOSTS", "class_name": "HlekkHostDO" },
      { "name": "HLEKK_DIRECTORY", "class_name": "HlekkDirectoryDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HlekkHostDO", "HlekkDirectoryDO"] }],
  "kv_namespaces": [{ "binding": "HLEKK_MAP", "id": "hlekk-map-demo" }],
  "vars": {
    "HLEKK_DATABASE": "demo",
    // Above what a host's SQLite weighs empty on workerd (40,960 B with the schema in place) and
    // below what the demo's writes take it to, so the controller can be watched shedding a run and
    // it is the data that crossed the line. A threshold under the empty size is tripped before a
    // single row exists and demonstrates nothing.
    //
    // Which is nearly what this is, and the figure is a workerd figure: a deployed host DO weighs
    // 45,056 B empty, measured on 43 of them in the Wikimedia pilot. So 45,000 sits *below* the
    // real empty size and this threshold would shed before a single row existed if this config
    // were ever deployed. It is not -- `npm run app` drives it on local workerd, where 40,960 is
    // the right number -- but the margin is 56 bytes on one platform and negative on the other,
    // which is too thin to leave unsaid.
    "HLEKK_SHED_BYTES": "45000",
    // Two rows a chunk, so every move the harness makes crosses in many chunks over real DO-to-DO
    // calls: the target pulling each one from the source, and the directory recording each cursor.
    "HLEKK_CHUNK_ROWS": "2"
  }
}
